# Opcional. Endpoint que recebe o formulário de contacto por POST (JSON com
# name, email, service, date, location, message) — por exemplo um form do
# Formspree ou
# Web3Forms. Sem esta variável o formulário abre o cliente de email do
# visitante, já preenchido, em vez de submeter por HTTP.
VITE_CONTACT_ENDPOINT=

# ── Galerias privadas (Supabase) ───────────────────────────────────────────
# Project Settings → API. Sem estas, /galeria e /admin ficam indisponíveis.
# As credenciais do Cloudflare R2 NÃO entram aqui: vivem nos secrets das Edge
# Functions, para nunca chegarem ao browser (ver README).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Modo de demonstração: galerias falsas em memória, para ver o desenho sem
# Supabase. NUNCA pôr a true num deploy real — nada fica protegido.
VITE_DEMO_GALLERIES=

# ── Estatísticas de visitas (opcional) ─────────────────────────────────────
# Sem VITE_ANALYTICS_SRC não se carrega script nenhum e o site não faz um único
# pedido a terceiros. Usar apenas ferramentas sem cookies (Plausible, Umami) —
# com cookies passa a ser preciso pedir consentimento e mudar a política de
# privacidade.
#   Plausible: SRC=https://plausible.io/js/script.js e DOMAIN=o-teu-dominio.pt
#   Umami:     SRC=https://cloud.umami.is/script.js e ID=<website id>
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_ID=
