# Opcional. Endpoint que recebe o formulário de contacto por POST (JSON com
# name, email, service, message) — por exemplo um form do Formspree ou
# Web3Forms. Sem esta variável o formulário abre o cliente de email do
# visitante, já preenchido, em vez de submeter por HTTP.
VITE_CONTACT_ENDPOINT=

# ── Galerias privadas (Supabase) ───────────────────────────────────────────
# Project Settings → API. Sem estas, /galeria e /admin ficam indisponíveis.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Modo de demonstração: galerias falsas em memória, para ver o desenho sem
# Supabase. NUNCA pôr a true num deploy real — nada fica protegido.
VITE_DEMO_GALLERIES=
