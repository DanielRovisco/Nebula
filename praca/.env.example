# ───────── Base ─────────
# Public URL of the app (used for canonical links, emails, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "development" | "staging" | "production". The "Dados de demonstração" banner shows whenever seed data exists and this is not "production".
NEXT_PUBLIC_APP_ENV=development

# ───────── Base de dados (PostgreSQL + PostGIS) ─────────
# Local (docker compose up -d db):  postgres://praca:praca@localhost:5432/praca
# Supabase/Neon: use the pooled connection string; enable the postgis and pg_trgm extensions first.
DATABASE_URL=postgres://praca:praca@localhost:5432/praca
# Direct (non-pooled) URL used only by migrations, if different.
DATABASE_URL_UNPOOLED=

# ───────── Auth.js v5 ─────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Google OAuth (optional). Redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ───────── Email ─────────
# Resend (production). Without a key, magic links go through SMTP (Mailpit) and, failing that, the server log.
RESEND_API_KEY=
EMAIL_FROM="Praça <ola@praca.example>"
SMTP_URL=smtp://localhost:1025

# ───────── Mapas ─────────
# Optional MapTiler key. Without it the app uses OpenFreeMap (free, no key).
NEXT_PUBLIC_MAPTILER_KEY=

# ───────── Armazenamento de imagens (Cloudflare R2 / Supabase Storage) ─────────
MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ───────── Pagamentos (fase 2) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────── Observabilidade e anti-abuso (opcional) ─────────
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───────── Identificação da entidade (rodapé / páginas legais) ─────────
NEXT_PUBLIC_ENTITY_NAME="Praça, Lda. (modelo)"
NEXT_PUBLIC_ENTITY_NIF=
NEXT_PUBLIC_ENTITY_AMI=
NEXT_PUBLIC_ENTITY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=ola@praca.example
